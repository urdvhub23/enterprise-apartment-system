# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# PostgreSQL (financial: users, apartments, leases, invoices, payments)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=apartment_billing
PG_USER=postgres
PG_PASSWORD=postgres

# MongoDB (flexible: complaints, notices, chat, notifications)
MONGO_URI=mongodb://localhost:27017/apartment_docs

# Email (notifications service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=changeme

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
